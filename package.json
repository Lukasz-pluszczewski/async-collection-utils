{
  "name": "async-collection-utils",
  "version": "2.0.0-rc.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup-node src/index.ts --dts",
    "test": "npm run test:runtime && npm run test:types",
    "test:runtime": "vitest --globals --coverage src/*.test.ts",
    "test:types": "vitest --globals --typecheck src/*.test-d.ts",
    "pack:check": "npm pack --dry-run --cache /tmp/npm-cache",
    "generateToc": "markdown-toc --bullets=\"*\" --no-firsth1 README.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lukasz-pluszczewski/async-collection-utils"
  },
  "author": "Łukasz Pluszczewski",
  "bugs": {
    "url": "https://github.com/Lukasz-pluszczewski/async-collection-utils/issues"
  },
  "homepage": "https://github.com/Lukasz-pluszczewski/async-collection-utils",
  "keywords": [
    "async",
    "forEach",
    "map",
    "reduce",
    "filter",
    "entries",
    "keys",
    "object",
    "array",
    "iterables",
    "generator",
    "stream"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.23",
    "@vitest/coverage-v8": "3.1.4",
    "benchmarkify": "^4.0.0",
    "markdown-toc": "^1.2.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
